{
  "name": "@vibeads/mcp",
  "version": "0.2.5",
  "mcpName": "io.github.vibeads/mcp",
  "description": "Official VibeAds MCP server \u2014 talk to your Google Ads account from Claude Desktop, Cursor, or any MCP-compatible client. Built for local service businesses (plumbers, HVAC, electricians, roofers, and 33 more categories).",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "google-ads",
    "ppc",
    "local-services",
    "anthropic",
    "vibeads"
  ],
  "homepage": "https://getvibeads.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/vibeads/mcp"
  },
  "author": "VibeAds",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "vibeads-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/index.js dist/cli-init.js || true",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo",
    "start": "node dist/index.js",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
